        <mxCell id="pool" value="Candidate pool &lt;i&gt;I&lt;/i&gt;&lt;sub&gt;t&lt;/sub&gt;&lt;br&gt;items &lt;i&gt;z&lt;/i&gt;&lt;sub&gt;i&lt;/sub&gt; = (&lt;i&gt;u&lt;/i&gt;&lt;sub&gt;i&lt;/sub&gt;, &lt;i&gt;p&lt;/i&gt;&lt;sub&gt;i&lt;/sub&gt;, &lt;i&gt;c&lt;/i&gt;&lt;sub&gt;i&lt;/sub&gt;)&lt;br&gt;utility uncertainty &lt;i&gt;d&lt;/i&gt;&lt;sub&gt;i&lt;/sub&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;strokeColor=#333333;spacing=4;fillColor=#FFFFFF;" parent="1" vertex="1">
          <mxGeometry x="40" y="95" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="req" value="Request: role &lt;i&gt;r&lt;/i&gt;&lt;sub&gt;t&lt;/sub&gt;, context &lt;i&gt;κ&lt;/i&gt;&lt;sub&gt;t&lt;/sub&gt;&lt;br&gt;threshold &lt;i&gt;τ&lt;/i&gt;, weights &lt;i&gt;λ&lt;/i&gt;,&lt;br&gt;uncertainty budget Γ" style="rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;strokeColor=#333333;spacing=4;fillColor=#FFFFFF;" parent="1" vertex="1">
          <mxGeometry x="290" y="95" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;1. Policy transformation&lt;/b&gt; Π&lt;sub&gt;&lt;i&gt;P&lt;/i&gt;&lt;/sub&gt;&lt;br&gt;redact, aggregate, generalise" style="rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;strokeColor=#333333;spacing=4;fillColor=#F2F2F2;" parent="1" vertex="1">
          <mxGeometry x="100" y="210" width="290" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2. Hard admissibility&lt;/b&gt; χ&lt;sub&gt;&lt;i&gt;P&lt;/i&gt;&lt;/sub&gt;&lt;br&gt;keep permitted items only → &lt;i&gt;D&lt;/i&gt;&lt;sub&gt;t&lt;/sub&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;strokeColor=#333333;spacing=4;fillColor=#F2F2F2;" parent="1" vertex="1">
          <mxGeometry x="100" y="285" width="290" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3. Sufficient?&lt;/b&gt;&lt;br&gt;&lt;i&gt;U&lt;/i&gt;(&lt;i&gt;D&lt;/i&gt;&lt;sub&gt;t&lt;/sub&gt;) ≥ &lt;i&gt;τ&lt;/i&gt;&lt;br&gt;under Γ" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fillColor=#FFE9D6;strokeColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="125" y="360" width="240" height="95" as="geometry" />
        </mxCell>
        <mxCell id="inf" value="&lt;b&gt;Infeasible, with diagnostic&lt;/b&gt;&lt;br&gt;shortfall &lt;i&gt;τ&lt;/i&gt; − &lt;i&gt;U&lt;/i&gt;(&lt;i&gt;D&lt;/i&gt;&lt;sub&gt;t&lt;/sub&gt;)&lt;br&gt;release restoring sufficiency:&lt;br&gt;fewest items or least exposure" style="rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;strokeColor=#333333;spacing=4;fillColor=#FDE4E4;" parent="1" vertex="1">
          <mxGeometry x="440" y="360" width="235" height="95" as="geometry" />
        </mxCell>
        <mxCell id="act" value="lower &lt;i&gt;τ&lt;/i&gt;, grant a permission,&lt;br&gt;gather evidence, or escalate" style="rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;strokeColor=#333333;spacing=4;fillColor=#FFFFFF;" parent="1" vertex="1">
          <mxGeometry x="440" y="480" width="235" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4. Select minimum sufficient subset&lt;/b&gt;&lt;br&gt;min&lt;sub&gt;&lt;i&gt;S&lt;/i&gt; ⊆ &lt;i&gt;D&lt;/i&gt;&lt;sub&gt;t&lt;/sub&gt;&lt;/sub&gt; &lt;i&gt;J&lt;/i&gt;(&lt;i&gt;S&lt;/i&gt;) = &lt;i&gt;λ&lt;/i&gt;&lt;sub&gt;&lt;i&gt;P&lt;/i&gt;&lt;/sub&gt;&lt;i&gt;P&lt;/i&gt; + &lt;i&gt;λ&lt;/i&gt;&lt;sub&gt;&lt;i&gt;C&lt;/i&gt;&lt;/sub&gt;&lt;i&gt;C&lt;/i&gt; + &lt;i&gt;λ&lt;/i&gt;&lt;sub&gt;&lt;i&gt;K&lt;/i&gt;&lt;/sub&gt;&lt;i&gt;K&lt;/i&gt;&lt;br&gt;s.t. &lt;i&gt;U&lt;/i&gt;(&lt;i&gt;S&lt;/i&gt;) ≥ &lt;i&gt;τ&lt;/i&gt; when any Γ selected&lt;br&gt;utilities are overestimated" style="rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;strokeColor=#333333;spacing=4;fillColor=#F2F2F2;" parent="1" vertex="1">
          <mxGeometry x="100" y="480" width="290" height="85" as="geometry" />
