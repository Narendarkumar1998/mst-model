        <mxCell id="solv" value="Solver skills: mixed-integer model (SCIP),&lt;br&gt;exhaustive search for small pools;&lt;br&gt;ties broken by the comparison tuple Φ" style="rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;strokeColor=#333333;spacing=4;fillColor=#FAFAFA;" parent="1" vertex="1">
